# Root .env for docker compose. Copy to .env and adjust.
#   cp .env.example .env
#
# These values are read by docker-compose.yml only. Application defaults live
# in backend/.env.example and frontend/.env.example.

# ---------------------------------------------------------------------------
# Host port mappings
# ---------------------------------------------------------------------------
# Only affects <host>:<container> publishing. Containers always talk to each
# other on the internal ports (postgres:5432, redis:6379, backend:3001).
# Change these if something already listens on your machine.
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
BACKEND_HOST_PORT=3001
FRONTEND_HOST_PORT=3000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_NAME=courier_service
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Schema management. There is no schema-creating migration yet, so TypeORM
# synchronize builds the tables. Flip DB_SYNCHRONIZE to false once real schema
# migrations exist, and keep USE_MIGRATIONS=true to apply them.
DB_SYNCHRONIZE=true
USE_MIGRATIONS=true

# ---------------------------------------------------------------------------
# Auth — replace before any non-local deployment
# ---------------------------------------------------------------------------
JWT_SECRET=changeme_jwt_secret_32chars_min
JWT_REFRESH_SECRET=changeme_refresh_secret_32chars
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=FastX Courier <noreply@fastxcourier.com>

# ---------------------------------------------------------------------------
# Frontend (NEXT_PUBLIC_* is baked at image build time — rebuild after edits)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=FastX Courier
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true

# ---------------------------------------------------------------------------
# Dev overlay only — set to true if file watching misses changes
# ---------------------------------------------------------------------------
CHOKIDAR_USEPOLLING=false
WATCHPACK_POLLING=false

# Dev container UID/GID mapping (docker-compose.dev.yml)
DOCKER_UID=1000
DOCKER_GID=1000
